# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/
venv/

# generated runs (regenerate with: python -m simkit gen -c scenes\... -o out\...)
out/
*.log

# YOLO exports (regenerate with: python tools\export_yolo.py)
datasets/

# blender / third-party runtimes (never commit; download the portable build)
third_party/
*.blend1

# local notes that must not be published
docs/_local/

# folder-picker history: contains absolute paths of the operator's disk
configs/known_outputs*.json

# scratch
_src/
_tmpgen_*.py
_tmp/
_tmp_iso/
_lidar/

# vision-router side files
.dsh-vision-router/

.DS_Store
Thumbs.db

# raw model downloads (regenerate with: python tools/fetch_vehicle_models.py)
assets/_cache/
# intermediate preview renders; the shipped copies live beside each .obj
assets/models/previews/

# scratch probe folders from ad-hoc testing
sgprobe_*/

# GitHub Actions workflow: pushing it needs a token with the `workflow`
# scope, which the current credential does not have. Kept on disk; add it
# back once a properly scoped token is in place.
.github/workflows/

# agent orchestration scaffolding and local secrets (never published)
.env
.env.local
.env.*.local
.claude/
.claude-flow/
.agents/
.swarm/
.mcp.json
CLAUDE.md

# Node tooling: the site probes and the orchestration CLIs install here
node_modules/
.ruflo/

# workspace memory / agent notes (never published)
.workbuddy/
