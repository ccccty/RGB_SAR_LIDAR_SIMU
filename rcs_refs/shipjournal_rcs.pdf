e{overflow-wrap:anywhere;color:var(--bw-accent)}.bw-body{padding:26px 32px 26px;text-align:center}.bw-hero{display:block;width:88px;height:95px;margin:0 auto}.bw-hero-canvas{display:block;width:88px;height:95px}.bw-title{margin:18px 0 8px;font:700 1rem/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;letter-spacing:.06em;color:var(--bw-ink)}.bw-subtitle{margin:0 auto;max-width:330px;font:400 0.8125rem/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--bw-ink-soft)}.bw-status{min-height:42px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;margin-top:16px;padding:9px 12px;background:var(--bw-status-bg);border:1px solid var(--bw-border);border-radius:4px;font:500 0.75rem/1.5 ui-monospace,SFMono-Regular,Menlo,Consolas,"Liberation Mono",monospace;text-align:left}#challenge-error{margin:0;color:var(--bw-danger)}#challenge-error:empty{display:none}.bw-status-decor{color:var(--bw-accent)}.bw-caret{animation:bw-caret 1s steps(1) infinite}.bw-retry{min-height:2.5rem;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;margin-top:10px;font:400 0.75rem/1.2 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;color:var(--bw-ink-soft);visibility:hidden}.bw-retry.bw-visible{visibility:visible}.bw-retry-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:0 2px}.bw-retry-help{font-size:.6875rem;font-weight:400}.bw-retry-btn{display:inline-flex;align-items:center;gap:4px;min-height:24px;padding:2px 4px;border:0;border-radius:4px;background:0 0;color:inherit;font:inherit;text-decoration:underline;text-underline-offset:2px;cursor:pointer}.bw-retry-btn svg{width:11px;height:11px;flex-shrink:0}.bw-retry-btn:hover{color:var(--bw-primary)}.bw-retry-btn:focus-visible{outline:2px solid var(--bw-primary);outline-offset:2px}.bw-widget{width:300px;height:65px;box-sizing:border-box